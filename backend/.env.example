# =====================================================================
# AI MASS COMMUNICATION PLATFORM - CONFIGURATION
# =====================================================================

# Database Configuration (MySQL 8.0+)
# Example: mysql+pymysql://root:yourpassword@localhost:3306/mass_comm_db
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/mass_comm_db

# Fallback to SQLite if MySQL is unreachable or not yet configured:
USE_SQLITE_FALLBACK=true

# Free AI Provider Configuration:
# Choose 'gemini' (Recommended) or 'groq'
AI_PROVIDER=gemini

# Google Gemini API Key (Get a free API key from https://aistudio.google.com)
GEMINI_API_KEY=

# Groq API Key (Optional alternative: https://console.groq.com/keys)
GROQ_API_KEY=

# Default Model Choices
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# =====================================================================
# Step 2: Translation Provider Configuration (Bhashini / IndicTrans2)
# =====================================================================
# Options: 'auto' | 'bhashini' | 'indictrans2' | 'gemini' | 'groq'
TRANSLATION_PROVIDER=auto

# Bhashini (National Language Translation Mission - https://bhashini.gov.in)
# Sign up on Bhashini / ULCA portal to get User ID and API Keys
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=

# Hugging Face Inference API for AI4Bharat IndicTrans2 models (https://huggingface.co/settings/tokens)
# Model: ai4bharat/indictrans2-en-indic-1B
HUGGINGFACE_API_KEY=

# =====================================================================
# Step 4: Sentiment & Tone Analysis (VADER + LLM)
# =====================================================================
# VADER runs locally (pip install vaderSentiment) — no API key needed.
# Tone suggestions reuse the AI_PROVIDER key above (Gemini or Groq).
# Set include_tone_suggestions=false in the request to skip LLM calls.
# No additional configuration required for Step 4.

# =====================================================================
# Step 5: AI Quality & Compliance Check (LanguageTool + Rules + LLM)
# =====================================================================
# Grammar: Uses LanguageTool HTTP API. Default is the free public API.
# To self-host (no rate limits), run:
#   docker run -d -p 8010:8010 erikvl87/languagetool
# Then set LANGUAGETOOL_URL=http://localhost:8010/v2/check
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check

# Compliance: Pure Python rules engine (banned words, length limits,
# required disclaimers). Zero cost, zero dependency.
# Factual check reuses the AI_PROVIDER key above (Gemini or Groq).
# Set include_factual_check=false in the request to skip LLM calls.

# =====================================================================
# Channel 1: Email (Gmail / Enterprise SMTP)
# =====================================================================
# For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ConnectAI Mass Communications

# Modern HTTP Email APIs (Recommended for Cloud Hosting like Render / Vercel where SMTP ports 587/465 are blocked):
# Resend: Get free API key at https://resend.com (3,000 free emails/mo)
RESEND_API_KEY=
# Brevo: Get free API key at https://brevo.com (300 free emails/day)
BREVO_API_KEY=

# =====================================================================
# Channels 2 & 3: SMS & WhatsApp (Twilio)
# =====================================================================
# Twilio Console credentials: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio trial phone number from your Twilio Console (SMS sender)
TWILIO_PHONE_NUMBER=+17372508034
# Twilio WhatsApp trial sender number (From your sandbox)
TWILIO_WHATSAPP_NUMBER=+17372508034

